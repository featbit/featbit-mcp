{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aspire: Launch AppHost",
      "type": "aspire",
      "request": "launch",
      "preLaunchTask": "kill-apphost",
      "program": "${workspaceFolder}/FeatBit/FeatBit.AppHost/FeatBit.AppHost.csproj"
    },
    {
      "name": "MCP Server (Standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mcpserver",
      "program": "${workspaceFolder}/FeatBit/FeatBit.McpServer/bin/Debug/net10.0/FeatBit.McpServer.dll",
      "args": [],
      "cwd": "${workspaceFolder}/FeatBit/FeatBit.McpServer",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5180"
      }
    }
  ]
}
